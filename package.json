{
  "name": "microsoft-admin-mcp",
  "version": "0.3.0",
  "description": "MCP server for Microsoft Azure, Entra ID, Intune and PowerShell automation. Read plus confirmed-write operations via Microsoft Graph and Azure Resource Manager.",
  "type": "module",
  "license": "MIT",
  "author": "Xander Oortgiesen",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microsoft-graph",
    "azure",
    "entra",
    "intune",
    "powershell"
